#!/bin/bash
# tools/hooks/pre-push —— 推送门禁：回归不过就不许 push
# 注意：Windows 下必须 #!/bin/bash；用 #!/usr/bin/env bash 会被 Git 报 Permission denied
#
# 启用（每个克隆只需一次，配置存在 .git/config，不进库）：
#   git config core.hooksPath tools/hooks
# 临时跳过（仅限紧急文档推送，慎用）：
#   FPGA_CAR_SKIP_SIM=1 git push
set -uo pipefail

if [ "${FPGA_CAR_SKIP_SIM:-0}" = "1" ]; then
    echo "pre-push: 已跳过回归（FPGA_CAR_SKIP_SIM=1）"
    exit 0
fi

repo=$(git rev-parse --show-toplevel) || exit 1
echo "pre-push: 运行全量回归（tools/run_regression.sh）..."
if bash "$repo/tools/run_regression.sh"; then
    echo "pre-push: 回归通过，允许推送"
    exit 0
fi
echo "pre-push: 回归未通过，已阻止推送。修好后再推，或用 FPGA_CAR_SKIP_SIM=1 显式跳过。" >&2
exit 1
